#!/bin/sh /etc/rc.common
# Authenticating utility for auth.tsinghua.edu.cn
# This init script is used explicitly with OpenWRT
# https://github.com/z4yx/GoAuthing/blob/master/docs/init.d/goauthing%40

USE_PROCD=1
START=98
PROG="/usr/bin/goauthing"
SERV=goauthing  # UCI config at /etc/config/goauthing

start_instance() {
  local username password
  config_get username config username
  config_get password config password
  [ -x "$PROG" ] || return 1
  [ -n "$username" ] && [ -n "$password" ] || return 1

  procd_open_instance
  # The script is constant. Credentials are data, never shell source.
  procd_set_param command /bin/sh -c '
    "$1" -u "$2" -p "$3" deauth --insecure
    "$1" -u "$2" -p "$3" auth --insecure || exit $?
    exec "$1" -u "$2" -p "$3" online
  ' goauthing "$PROG" "$username" "$password"
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param respawn
  procd_close_instance
}

start_service() {
  config_load "$SERV"
  config_get_bool enabled config enabled 0
  if [ "$enabled" = "0" ]; then
    return
  fi
  start_instance
}

stop_service() {
  "$PROG" deauth --insecure
}

# Custom reload function to restart the service
service_triggers() {
  procd_add_reload_trigger "goauthing"
}

reload_service() {
  stop
  start
}
