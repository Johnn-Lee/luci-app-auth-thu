{
	"luci-app-auth-thu": {
		"description": "Grant access to Auth THU configuration",
		"read": {
			"ubus": {
				"service": ["list"],
				"uci": ["get", "load"]
			},
			"uci": [ "goauthing" ],
			"file": {
				"/usr/bin/goauthing --version": ["exec"],
				"/sbin/logread": ["exec"],
				"/usr/sbin/logread": ["exec"],
				"/usr/bin/wget -qO- https://api.github.com/repos/z4yx/GoAuthing/releases/latest": ["exec"],
				"/bin/wget -qO- https://api.github.com/repos/z4yx/GoAuthing/releases/latest": ["exec"],
				"/bin/uclient-fetch -qO- https://api.github.com/repos/z4yx/GoAuthing/releases/latest": ["exec"],
				"/bin/uname": ["exec"],
				"/usr/bin/uname": ["exec"]
			}
		},
		"write": {
			"ubus": {
				"uci": ["set", "save", "commit"]
			},
			"uci": [ "goauthing" ],
			"file": {
				"/usr/libexec/auth-thu-download": ["exec"],
				"/etc/init.d/goauthing": ["exec"]
			}
		}
	}
}
